#!/usr/bin/env sh
set -eu

save() {
	for x; do
		printf "'" && printf %s "$x" | sed "s/'/'\\\\''/g" && printf "' " \
			|| return 1
	done
}

runorraise() {
	case "${1-}" in
	--app-id=*) APP_ID="${1#--app-id=}" && shift ;;
	*) APP_ID='%s' "${1##*/}" ;;
	esac
	case "${XDG_CURRENT_DESKTOP:-$(
		[ -z "${NIRI_SOCKET-}" ] || { echo niri && return; }
		[ -z "${SWAYSOCK-}" ] || { echo sway && return; }
		[ "$(uname -s)" != Darwin ] || { echo aqua && return; }
	)}" in
	niri)
		NIRI_APP_ID="$(
			niri msg --json windows | jq --arg app "${APP_ID}" '
				[
				  .[]
				  | select(
					  .app_id
					  | ascii_downcase
					  | endswith($app | ascii_downcase)
					)
				]
				| sort_by(.focus_timestamp.secs)
				[-1]
				| .id
			'
		)"
		if [ "$NIRI_APP_ID" = "null" ]; then
			[ $# -gt 0 ] || return 0
			niri msg action spawn -- "$@"
		else
			niri msg action focus-window --id "${NIRI_APP_ID}"
		fi
		;;
	sway)
		if ! swaymsg "[app_id=(?i)^${APP_ID}\$] focus" >/dev/null 2>&1; then
			[ $# -gt 0 ] || return 0
			swaymsg -- exec "$(save "$@")"
			i=0
			until
				i="$((${i-0} + 1))" && [ "$i" -gt 9 ] \
					|| swaymsg -t subscribe '[ "window" ]' \
					| jq -e '.change == "new"' >/dev/null 2>&1
			do
				sleep 0.1
			done
			swaymsg "[app_id=(?i)^${APP_ID}\$] focus"
		fi
		;;
	aqua) echo aqua ;;
	esac
}

runorraise "$@"
