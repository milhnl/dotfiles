prepare() {
	local top dest
	while read -r top dest; do
		[ -n "$top" ] || continue
		rm -rf "$dest" # empty placeholder dir from the base archive
		mv "../$top" "$dest"
	done <<EOF
$_submodules
EOF
}

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		CMAKE_CROSSOPTS="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	# LIBRETRO_STATIC (dolphin's own option) statically links the C++ runtime so
	# the core stays self-contained; USE_SYSTEM_LIBS=OFF + BUILD_SHARED_LIBS=OFF
	# build the vendored externals as static libs instead of pulling system ones.
	cmake -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=None \
		-DLIBRETRO=On \
		-DLIBRETRO_STATIC=1 \
		-DUSE_SYSTEM_LIBS=OFF \
		-DBUILD_SHARED_LIBS=OFF \
		$CMAKE_CROSSOPTS .
	cmake --build build
}

package() {
	install -Dm755 build/dolphin_libretro.so \
		"$pkgdir"/usr/lib/libretro/dolphin_libretro.so
}
