pkgname=libretro-mame2003-plus
# pinned to a commit of upstream master
pkgver=0_git20260915
pkgrel=0
_commit=5da0428c7f9536577febfa092543c98d3b5767b4
pkgdesc="libretro core for MAME2003 Plus (MAME 0.78 plus later drivers)"
url="https://github.com/libretro/mame2003-plus-libretro"
license="MAME-2003-noncommercial"
arch="aarch64 x86_64"
makedepends="
	build-base
"
# plain C project, statically links libm; no runtime deps besides libc
source="$pkgname-$_commit.tar.gz::https://github.com/libretro/mame2003-plus-libretro/archive/${_commit}.tar.gz"
builddir="$srcdir/mame2003-plus-libretro-$_commit"
options="!check" # no test suite

build() {
	make platform=unix
}

package() {
	install -Dm644 mame2003_plus_libretro.so \
		"$pkgdir"/usr/lib/libretro/mame2003_plus_libretro.so
}

