pkgname=quickshell
pkgver=0.3.1
pkgrel=0
pkgdesc="Declarative desktop widgets and shell components in QML"
url="https://quickshell.org/"
license="LGPL-3.0"
arch="x86_64 aarch64"
makedepends="
	build-base
	cmake
	cli11
	pkgconf
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	qt6-qtshadertools-dev
	qt6-qtwayland
	qt6-qtwayland-dev
	qt6-qtsvg-dev
	wayland
	wayland-dev
	wayland-protocols
	libdrm-dev
	mesa-dev
	vulkan-headers
	pipewire-dev
	linux-pam-dev
	jemalloc-dev
	"
depends="
	qt6-qtbase
	qt6-qtdeclarative
	qt6-qtshadertools
	qt6-qtwayland
	qt6-qtsvg
	wayland
	libdrm
	libxcb
	mesa-gbm
	pipewire-libs
	libstdc++
	linux-pam
	jemalloc
	"
source="https://github.com/quickshell-mirror/quickshell/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DDISTRIBUTOR="Alpine Linux" \
		-DCRASH_HANDLER=OFF \
		-DSERVICE_POLKIT=OFF \
		-DINSTALL_QMLDIR=/usr/lib/qt6/qml

	cmake --build build
}

package() {
	DESTDIR="${pkgdir}" cmake --install build
}

sha512sums="
