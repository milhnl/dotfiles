#!/usr/bin/env sh

gui() {
	set -- "$(
		ps -A -o user,pid,comm \
			| awk -v user="$(id -un)" '
				NR > 1 && $1 == user && $3 == "sway" { print $3, $2; exit }
			'
	)" "$@"
	case "${1% *}" in
	sway)
		export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR-/run/user/$(id -u)}"
		export SWAYSOCK="$XDG_RUNTIME_DIR/sway-ipc.$(id -u).${1#* }.sock"
		export WAYLAND_DISPLAY="$(
			WAYLAND_DISPLAY="$SWAYSOCK.display"
			mkfifo "$WAYLAND_DISPLAY"
			swaymsg exec \
				"echo \"\$WAYLAND_DISPLAY\">\"$WAYLAND_DISPLAY\"" >/dev/null
			cat "$WAYLAND_DISPLAY"
			rm "$WAYLAND_DISPLAY"
		)"
		;;
	esac
	shift
	exec "$@"
}

gui "$@"
