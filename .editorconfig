[*]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 79
# Many shell scripts have no extension
binary_next_line = true

[*.lua]
indent_size = 2
quote_type = single

[*.css]
indent_size = 2

[{XDG_BIN_HOME,HOME,PREFIX/src,PREFIX/lib/sh,XDG_CONFIG_HOME/sh}/**]
indent_style = tab

[{PKGBUILD,*.PKGBUILD}]
indent_style = space
indent_size = 2
