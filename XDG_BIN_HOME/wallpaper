#!/usr/bin/env sh
#wallpaper - change wallpaper
set -eu

die() { if [ "$#" -gt 0 ]; then printf "%s\n" "$*" >&2; fi && exit 1; }
quote() {
	for x; do
		printf "'" && printf %s "$x" | sed "s/'/'\\\\''/g" && printf "' " \
			|| return 1
	done
}

wallpaper() {
	[ -n "${1-}" ] || die "Usage: ${0##*/} <path>"
	set -- "$(realpath "$1")"
	case "$(uname -s)" in
	Darwin)
		set -- "$1" "$HOME/Library/Application Support/com.apple.wallpaper$(
		)/Store/Index.plist"
		set -- "$1" "$2" "$(mktemp "$2.XXXXXX")" \
			"$(date -u +%Y-%m-%dT%H:%M:%SZ)"
		set -- "$1" "$2" "$3" "$4" "$(
			jq -cn --arg path "$1" '{
				type: "imageFile",
				url: {
					relative: ("file://"
						+ ($path | split("/") | map(@uri) | join("/")))
				}
			}' \
				| plutil -convert binary1 -o - - \
				| base64
		)"
		#shellcheck disable=SC2064
		trap "$(quote rm -f "$3")" 0
		cp "$2" "$3"
		plutil -replace "SystemDefault.Desktop.Content.Choices" -xml "
			<array>
				<dict>
					<key>Provider</key>
					<string>com.apple.wallpaper.choice.image</string>
					<key>Files</key>
					<array />
					<key>Configuration</key>
					<data>$5</data>
				</dict>
			</array>
		" "$3"
		plutil -replace "SystemDefault.Desktop.Content.Shuffle" -string \
			"\$null" "$3"
		plutil -replace "SystemDefault.Desktop.LastSet" -date "$4" "$3"
		plutil -replace "SystemDefault.Desktop.LastUse" -date "$4" "$3"
		plutil -replace AllSpacesAndDisplays -xml \
			"$(plutil -extract SystemDefault xml1 -o - "$3")" "$3"
		plutil -replace Spaces -json '{}' "$3"
		plutil -replace Displays -json '{}' "$3"
		mv "$3" "$2"
		killall WallpaperAgent
		;;
	Linux)
		#shellcheck disable=SC2009
		if ps -o comm= | grep -Fx quickshell >/dev/null; then
			set -- "$(quickshell ipc call wallpaper set "$1")"
			[ -z "$1" ] || die "$1"
		elif [ "$XDG_SESSION_DESKTOP" = gnome ] \
			|| [ "$XDG_SESSION_DESKTOP" = phosh ] \
			|| [ "$XDG_SESSION_DESKTOP" = gnome-xorg ]; then
			gsettings set org.gnome.desktop.background picture-uri \
				"file://$1"
			gsettings set org.gnome.desktop.background picture-options zoom
		elif grep -iq microsoft /proc/version 2>/dev/null; then
			set -- "$1" "$(cmd.exe /c 'echo %USERPROFILE%')/$(basename "$1")"
			set -- "$1" "$(echo "$2" | sed 's/\r//')"
			cp "$1" "$(wslpath -u "$2")"
			reg.exe add "HKCU\Control Panel\Desktop" /f /v Wallpaper /d "$2"
			rundll32.exe user32.dll, UpdatePerUserSystemParameters
		elif [ -n "$SWAYSOCK" ]; then
			swaymsg output \* bg "$1" fill
		else
			printf "Not supported\n"
			exit 1
		fi
		;;
	*)
		printf "Not supported\n"
		exit 1
		;;
	esac
}

wallpaper "$@"
