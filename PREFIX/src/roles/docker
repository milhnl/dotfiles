#!/usr/bin/env sh
set -eu

exists() { command -v "$1" >/dev/null 2>&1; }

if exists apt-get; then
	sudo apt-get update
	sudo apt-get install -yq apt-transport-https ca-certificates curl gnupg \
		lsb-release
	keyring="/usr/share/keyrings/docker-archive-keyring.gpg"
	distro="$(lsb_release -is 2>/dev/null | awk "{ print(tolower(\$0)) }")"
	[ -e "$keyring" ] \
		|| curl -fsSL "https://download.docker.com/linux/$distro/gpg" \
		| sudo gpg --dearmor -o "$keyring"
	printf "deb [arch=%s signed-by=%s] %s %s stable" \
		"$(dpkg --print-architecture)" "$keyring" \
		"https://download.docker.com/linux/$distro" "$(lsb_release -cs)" \
		| sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
	sudo apt-get update
	sudo apt-get install -yq docker-ce docker-ce-cli containerd.io \
		docker-buildx-plugin docker-compose-plugin
elif exists brew; then
	brew install -y colima docker docker-compose docker-credential-helper
	colima status >/dev/null 2>&1 || colima start --ssh-config=false >&2
elif exists pacman; then
	sudo pacman --needed --noconfirm -qS docker docker-compose
fi
if [ "$(uname -s)" = Linux ]; then
	printf 'm %s docker\n' "${FOR_USER:-$(whoami)}" | sudo systemd-sysusers
fi

if exists systemctl; then
	sudo mkdir -p /etc/docker
	printf '%s\n' \
		'{' \
		'    "log-driver": "journald",' \
		'    "log-opts": {' \
		'        "tag": "{{.Name}}"' \
		'    }' \
		'}' \
		| sudo tee /etc/docker/daemon.json >/dev/null
	sudo systemctl enable docker
	sudo systemctl restart docker
fi
