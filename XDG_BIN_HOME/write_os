#!/usr/bin/env sh
#shellcheck disable=SC2016
#write_os - write os to device/file
set -eu

escape() { echo "$1" | sed "s/'/'\\\\''/g"; }
exists() { command -v "$1" >/dev/null 2>&1; }
die() { if [ "$#" -gt 0 ]; then printf "%s\n" "$*" >&2; fi && exit 1; }
device_of() { df -P "$1" | awk 'END { print $1 }'; }
fnmatch() { case "$2" in $1) return 0 ;; *) return 1 ;; esac }
in_dir() (cd "$1" && shift && "$@")
to_argv() (
	set +x
	while read -r LINE; do set -- "$@" "$LINE"; done
	"$@"
)
quote() {
	for x; do
		printf "'" && printf %s "$x" | sed "s/'/'\\\\''/g" && printf "' " \
			|| return 1
	done
}
sponge() { set -- "$1" "$(mktemp)" && cat >"$2" && sudo mv "$2" "$1"; }

clean() {
	sync
	(
		set -- boot ''
		while [ $# -ne 0 ]; do
			set -- "$(get_dev_for "$ROOT${1:+/$1}")" "$@"
			! [ -e "$ROOT${2:+/$2}" ] || [ -z "$1" ] \
				|| sudo umount "$1"
			shift 2
		done
	)
	if losetup --help 2>&1 | grep -q -e '--output'; then
		losetup -nONAME -j "${BACKING_FILE-$FILE}"
	else
		{ losetup -a 2>/dev/null || :; } \
			| awk -vpath="${BACKING_FILE-$FILE}" '
				{
					if (index($0, path))
						print substr($0, 1, index($0, ":") - 1)
				}
			'
	fi | xargs -rn 1 sudo losetup -d
	sudo rm -r "$ROOT"
}

download() ( #1: url, 2: path
	mkdir -p "$(dirname "$2")" || return 1
	tmp="$(mktemp "$2.XXXXXX")" || return 1
	trap 'rm -f "$tmp"' EXIT
	if exists curl; then
		if [ -e "$2" ]; then
			status="$(curl -fL -o "$tmp" -z "$2" -w '%{http_code}' "$1")" \
				|| return 1
			[ "$status" != 304 ] || return 0
		else
			curl -fLo "$tmp" "$1" || return 1
		fi
	elif exists wget; then
		wget "$1" -O "$tmp" || return 1
	else
		return 1
	fi
	mv -f "$tmp" "$2"
)

uname_to_arch() {
	case "$(uname -m)" in
	x86_64) echo x86_64 ;;
	aarch64 | arm64) echo aarch64 ;;
	armv7l) echo armv7 ;;
	armv6l) echo armhf ;;
	i?86) echo x86 ;;
	esac
}

distro_id() {
	cat /etc/os-release 2>/dev/null | sed -En 's/^ID="?(.*)"?$/\1/p'
}

get_rpi_image() { #1: version
	set -- "$(echo "$ARCH" | sed 's/armv6//')"
	set -- "rpi${1:+-$1}"
	set -- "http://os.archlinuxarm.org/os/ArchLinuxARM-${1}-latest.tar.gz"
	set -- "$1" "${XDG_CACHE_HOME:-$HOME/.cache}/rpi_img/${1##*/}"
	download "$@"
	echo "$2"
}

get_dev_for() { #1: path
	mount | sed -n 's|\(/dev/[^ ]*\) on '"$1"' .*|\1|p'
}

crude_wipefs() { #1: dev
	set -- "$1" "$(blockdev --getsz "$1")"
	dd if=/dev/zero of="$1" bs=512 count=2048
	dd if=/dev/zero of="$1" bs=512 seek=$(($1 - 2048)) count=2048
}

create_root() { #1: device 2: root 3: disklabel 4?: size
	if exists apk; then
		apk add e2fsprogs sfdisk
	elif exists pacman; then
		sudo pacman --needed --noconfirm -qS e2fsprogs dosfstools
	fi
	mkfs.vfat --help >/dev/null 2>&1 || die "error: install mkfs.vfat"
	mkfs.ext4 2>&1 | grep -q Usage || die "error: install mkfs.ext4"

	if [ ! -b "$1" ]; then
		BACKING_FILE="$1"
		sudo modprobe loop
		sudo truncate -s "$4" "$1"
		if losetup --help 2>&1 | grep -q -e '--show'; then
			set -- "$(sudo losetup -fP --show "$1")" "$2" "$3" "${4:-}"
		else
			set -- "$(
				file="$(sudo losetup -f)"
				sudo losetup -P "$file" "$1"
				echo "$file"
			)" "$2" "$3" "${4:-}"
		fi
		expr "$1" : /dev/ >/dev/null || die "error: loopback setup failed"
		FILE="$1"
		sudo chown "$(whoami)" "$BACKING_FILE"
	fi
	set -- "$1" "$2" "$3" "${4:-}" "$(
		if [ "$3" = gpt ]; then
			case "$ARCH" in
			x86_64) echo 4f68bce3-e8cd-4db1-96e7-fbcaf984b709 ;;
			x86) echo 44479540-f297-41b2-9af7-d131d5f0458a ;;
			aarch64) echo b921b045-1df0-41c3-af44-4c6f280d3fae ;;
			armv7 | armhf) echo 69dad710-2ce4-4e3c-b16c-21a1d49abed3 ;;
			*) echo 0fc63daf-8483-4772-8e79-3d69d8477de4 ;;
			esac
		else
			echo L
		fi
	)"
	if [ "$HARDWARE" = standard ] && [ "${SWAP_SIZE+x}" != x ]; then
		SWAP_SIZE="$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo)K"
	fi
	if exists sfdisk; then
		{
			printf 'label: %s\n,1G,%s,*\n' "$3" "$(
				[ "$3" = gpt ] && echo U || echo 0c
			)"
			[ -z "${SWAP_SIZE:-}" ] || printf ',%s,S,-\n' "$SWAP_SIZE"
			printf ',+,%s\n' "$5"
		} \
			| sudo sfdisk "$1" --wipe always --wipe-partitions always
	else
		sudo wipefs -a "$1" || crude_wipefs "$1"
		case "$3" in
		dos)
			exists fdisk || die "error: install sfdisk or fdisk"
			{
				printf 'o; n;p;1;;+1G; t;c; '
				if [ -n "${SWAP_SIZE:-}" ]; then
					printf 'n;p;2;;+%s; t;2;82; n;p;3;;; ' "$SWAP_SIZE"
				else
					printf 'n;p;2;;; '
				fi
				printf 'a;1; w;q;\n'
			} \
				| tr -d \  | tr ';' '\n' \
				| sudo fdisk "$1" || true #Maybe rereading part table failed
			;;
		gpt)
			exists sgdisk || die "error: install sfdisk or sgdisk"
			sudo sgdisk -zo "$1"
			sudo sgdisk -n 1:0:1G -t 1:ef00 -A 1:set:2 "$1"
			if [ -n "${SWAP_SIZE:-}" ]; then
				sudo sgdisk -n "2:0:+$SWAP_SIZE" -t 2:8200 "$1"
				sudo sgdisk -N 3 -t "3:$5" "$1"
			else
				sudo sgdisk -N 2 -t "2:$5" "$1"
			fi
			;;
		esac
	fi
	sync
	sudo blockdev --rereadpt "$1" || sudo partprobe "$1" || :
	! exists mdev || mdev -s
	(
		set -- "$1" "$2" $(
			if exists lsblk; then
				lsblk -lnoPATH "$1" | sed 1d
			elif exists sfdisk; then
				sfdisk -l "$1" -qoDevice
			elif exists fdisk; then
				fdisk -l "$1"
			fi | sed -En 's:^(/dev[^ ]*).*:\1:p' | sort
		)
		yes | sudo mkfs.ext4 "${5:-$4}"
		sudo mount -t ext4 "${5:-$4}" "$2"
		sudo mkdir -p "$2/boot"
		yes | sudo mkfs.vfat -F 32 $3
		sudo mount -t vfat $3 "$2/boot"
		[ -z "${5:-}" ] || { sudo mkswap -L hibernate "$4"; }
	)
	[ -d "$2" ] && [ -d "$2/boot" ] || die "error: fs setup/mount failed"
}

ALPINE_REMOTE=https://dl-cdn.alpinelinux.org/alpine
ALPINE_LOCAL="/usr/local/share/pkg-mirror/alpine"

alpine_version_to_branch() { #1?: version
	[ $# -eq 1 ] || set -- "$(cat /etc/alpine-release)"
	case "$1" in
	*.*.*) set -- "${1%.*}" && echo "v${1#v}" ;;
	*) echo edge ;;
	esac
}

repo_location() { #1: root 2: repo 3: file
	printf "%s/%s/%s/%s%s" "$1" "$ALPINE_BRANCH" "$2" "$ARCH" "${3+/$3}"
}

apk_dl() { #1: repo 2: file
	mkdir -p "$(dirname "$(repo_location "$ALPINE_LOCAL" "$@")")"
	download \
		"$(repo_location "$ALPINE_REMOTE" "$@")" \
		"$(repo_location "$ALPINE_LOCAL" "$@")" \
		|| return 1
	repo_location "$ALPINE_LOCAL" "$@"
}

cp_dot() { #1: new_home 2: destdir
	sudo mkdir -p "${2-}$1/.local/dot"
	DOTFILES="$(
		if [ -e "${DOTFILES-}" ]; then
			echo "$DOTFILES"
		elif DOTFILES="$(readlink ~mil/.profile)"; then
			echo "${DOTFILES%/HOME/.profile}"
		else
			echo ~mil/.local/dot
		fi
	)"
	sudo cp -RPp "$DOTFILES/." "${2-}$1/.local/dot"
	sudo sh -c 'cd "$1"; shift; "$@"' -- "${2-}$1/.local/dot" \
		env \
		PREFIX="$1/.local" \
		XDG_BIN_HOME="$1/.local/bin" \
		XDG_CACHE_HOME="$1/.cache" \
		XDG_CONFIG_HOME="$1/.config" \
		XDG_DATA_HOME="$1/.local/share" \
		HOME="$1" \
		dest="${2}" find . -not -type d -exec sh -c 'for i; do \
			i="${i#./}"; f="$(printenv "${i%%/*}")/${i#*/}" || continue; \
			mkdir -p "$dest${f%/*}"; ln -fs "$HOME/.local/dot/$i" "$dest$f"; \
		done' -- {} +
}

write_selfprovision() (
	ROLES_ROOT="${ROLES_ROOT:-/root/.local/dot/PREFIX/src/roles}"
	PROVISION_SCRIPT="${PROVISION_SCRIPT:-/etc/local.d/init.start}"
	{ [ $# -ne 0 ] && [ "${1-}" != -- ]; } || set -- \
		-s init \
		-s sysusers \
		-s apk_wrapped \
		-s networking \
		-s ntp \
		-e FOR_USER=mil -s home \
		"$@"
	sudo mkdir -p "$(dirname "${ROOT+$ROOT/}$PROVISION_SCRIPT")"
	printf '%s\n' \
		'#!/bin/sh' \
		'set -eux' \
		'' \
		'exec </dev/null >>/var/log/local-provisioning.log 2>&1' \
		'cd '\'"$(escape "$ROLES_ROOT")"\''' \
		'' \
		| sudo tee "${ROOT+$ROOT/}$PROVISION_SCRIPT" >/dev/null
	while getopts 's:e:c:' OPT "$@"; do
		case "$OPT" in
		s)
			sudo [ ! -e "${ROOT+$ROOT/}$ROLES_ROOT/$OPTARG/script" ] \
				|| OPTARG="$OPTARG/script"
			printf 'sh -x %s\n' "$OPTARG" \
				| sudo tee -a "${ROOT+$ROOT/}$PROVISION_SCRIPT" >/dev/null
			;;
		e)
			printf 'export %s='\''%s'\''\n' "${OPTARG%%=*}" \
				"$(escape "${OPTARG#*=}")" \
				| sudo tee -a "${ROOT+$ROOT/}$PROVISION_SCRIPT" >/dev/null
			;;
		c)
			printf '%s\n' "${OPTARG}" \
				| sudo tee -a "${ROOT+$ROOT/}$PROVISION_SCRIPT" >/dev/null
			;;
		*) die "ERROR: Unknown option: %OPT" ;;
		esac
	done
	shift $((OPTIND - 1)) && OPTIND=1
	if [ $# -ne 0 ]; then
		printf 'export COMMAND=%s\n' "$(quote "$(quote "$@")")" \
			| sudo tee -a "${ROOT+$ROOT/}$PROVISION_SCRIPT" >/dev/null
		printf 'sh -x unattended_run\n' \
			| sudo tee -a "${ROOT+$ROOT/}$PROVISION_SCRIPT" >/dev/null
	fi
	printf '%s\n' \
		'' \
		'rm '\'"$(escape "$PROVISION_SCRIPT")"\''' \
		| sudo tee -a "${ROOT+$ROOT/}$PROVISION_SCRIPT" >/dev/null
	sudo chmod +x "${ROOT+$ROOT/}$PROVISION_SCRIPT"
)

write_selfprovision_systemd() {
	PROVISION_SCRIPT=/usr/local/sbin/local-provisioning \
		write_selfprovision "$@"
	sudo mkdir -p "$ROOT/etc/systemd/system"
	sudo tee "$ROOT/etc/systemd/system/local-provisioning.service" \
		>/dev/null <<-EOF
			[Unit]
			Wants=network-online.target
			After=network-online.target
			[Service]
			Type=oneshot
			TimeoutStartSec=0
			ExecStart=/usr/local/sbin/local-provisioning
			ExecStart=/usr/bin/systemctl disable local-provisioning.service
			[Install]
			WantedBy=multi-user.target
		EOF
	sudo mkdir -p "$ROOT/etc/systemd/system/multi-user.target.wants"
	sudo ln -sf /etc/systemd/system/local-provisioning.service \
		"$ROOT/etc/systemd/system/multi-user.target.wants/$(
		)local-provisioning.service"
}

write_selfprovision_openrc() {
	write_selfprovision "$@"
	sudo mkdir -p "$ROOT/etc"
	sudo touch "$ROOT/etc/.default_boot_services"
	sudo mkdir -p "$ROOT/etc/runlevels/default"
	sudo ln -sf /etc/init.d/local "$ROOT/etc/runlevels/default"
}

write_customization_shared() {
	cp_dot "/root" "$ROOT"
	cp_dot "/home/mil" "$ROOT"
	case "$INIT" in
	openrc) write_selfprovision_openrc "$@" ;;
	systemd) write_selfprovision_systemd "$@" ;;
	esac
	printf "%s" "$HOSTNAME" | sudo tee "$ROOT/etc/hostname" >/dev/null
	sudo chown 0:0 "$ROOT"
	sudo chmod 755 "$ROOT"
}

write_alpine_local_repositories() {
	for index in \
		"$ALPINE_LOCAL/$ALPINE_BRANCH"/*/"$ARCH"/APKINDEX.tar.gz \
		"$ALPINE_LOCAL/$ALPINE_BRANCH"/*/"$ARCH"/Packages.adb; do
		[ -f "$index" ] || continue
		printf 'set WRITE_OS_INDEX=%s\nndx ${WRITE_OS_INDEX}\n' "$index"
	done
}

write_alpine_repositories() (
	host_alpine_branch="$(alpine_version_to_branch)"
	write_alpine_local_repositories
	while IFS= read -r repo || [ -n "$repo" ]; do
		case "$repo" in
		/media/*)
			[ "$host_alpine_branch" = "$ALPINE_BRANCH" ] \
				&& [ -e "$repo/$ARCH" ] || continue
			;;
		esac
		printf '%s\n' "$repo" | sed "s|$host_alpine_branch|$ALPINE_BRANCH|"
	done <"${1:-/etc/apk/repositories}"
)

write_customization_alpine() {
	INIT=openrc write_customization_shared "$@"
	if exists apk; then
		(
			set -- \
				alpine-base abuild doas-sudo-shim \
				iwd iwd-openrc bonding dbus dbus-openrc rsync \
				curl git git-perl gnupg gnupg-scdaemon make ncurses zsh \
				ncurses-terminfo
			#Due to the SD card unmount
			! fnmatch 'rpi*' "$HARDWARE" \
				|| set -- "$@" linux-rpi raspberrypi-bootloader \
					alpine-base openssh openssl dosfstools e2fsprogs
			exists abuild-sign || apk add -q abuild apk-tools
			abuild-sign -e >/dev/null 2>&1 || abuild-keygen -qani
			APK_CONFIG_DIR="$ROOT/etc/apk" APK_DISTRO="$DISTRO" \
				apk-cache-mirror install-key
			if [ "$ARCH" != "$(apk --print-arch)" ]; then
				cp -- "/usr/share/apk/keys/$ARCH/"* /etc/apk/keys/
			fi
			repositories="$(mktemp)"
			trap 'rm -f -- "$repositories"' EXIT
			write_alpine_repositories >"$repositories"
			APK_DISTRO="$DISTRO" apk-cache-mirror \
				--mirror-root "$ROOT$(dirname "$ALPINE_LOCAL")" \
				fetch --arch "$ARCH" \
				--repositories-file "$repositories" "$@"
		)
	fi
}

write_distro_alpine() {
	if
		[ "$ARCH" = "$(uname_to_arch)" ] && [ "$(distro_id)" = alpine ] \
			&& [ "$HARDWARE" != live ]
	then
		ALPINE_VERSION="$(cat /etc/alpine-release)}"
		ALPINE_BRANCH="$(alpine_version_to_branch "$ALPINE_VERSION")"
		SOURCE=self
	else
		ALPINE_VERSION="${ALPINE_VERSION:-3.24.0}"
		ALPINE_BRANCH="$(alpine_version_to_branch "$ALPINE_VERSION")"
		SOURCE="$(
			if fnmatch "rpi*" "$HARDWARE"; then
				if [ "$(uname -s)" = Linux ]; then
					apk_dl releases "alpine-rpi-$ALPINE_VERSION-$ARCH.tar.gz"
				elif [ "$(uname -s)" = Darwin ]; then
					apk_dl releases "alpine-rpi-$ALPINE_VERSION-$ARCH.img.gz"
				fi
			else
				apk_dl releases "alpine-standard-$ALPINE_VERSION-$ARCH.iso"
			fi
		)"
	fi
	case "$SOURCE" in
	self)
		if
			{ [ "$HARDWARE" = standard ] && [ ! -d /sys/firmware/efi ]; } \
				|| fnmatch "rpi[1-4]" "$HARDWARE"
		then
			DISKLABEL="dos"
		else
			DISKLABEL="gpt"
		fi
		ROOT="$(mktemp -d)"
		trap clean EXIT
		if fnmatch "rpi*" "$HARDWARE" && mount | grep -q 'on /.modloop'; then
			DO_UMOUNT=1 copy-modloop
		fi
		create_root "$FILE" "$ROOT" "$DISKLABEL" "${SIZE-16G}"
		setup-disk "$ROOT"
		[ "$DISKLABEL" = gpt ] \
			|| fnmatch "rpi*" "$HARDWARE" \
			|| (</usr/share/syslinux/mbr.bin sudo tee "$FILE" >/dev/null)
		write_customization_alpine "$@"
		;;
	*.iso)
		! exists apk || sudo apk add -q xorriso
		ROOT="$(mktemp -d)"
		trap clean EXIT
		FILE="${FILE:-${SOURCE%.iso}.local.iso}"
		write_customization_alpine "$@"
		ROOTOVERLAY="$(mktemp)"
		tar -czf "$ROOTOVERLAY" -C "$ROOT" .
		if [ -b "$FILE" ]; then
			BACKING_FILE="$FILE"
			FILE="$(mktemp)"
		else
			sudo rm -f "$FILE"
		fi
		#if [ -b "$FILE" ]; then
		#    sudo wipefs -a "$FILE"
		#else
		#    sudo rm -f "$FILE"
		#fi
		sudo xorriso -indev "$SOURCE" -outdev "stdio:$FILE" \
			-boot_image any replay -map "$ROOTOVERLAY" /localhost.apkovl.tar.gz
		if [ -n "${BACKING_FILE-}" ]; then
			dd if="$FILE" of="$BACKING_FILE"
			rm "$FILE"
		else
			sudo chown "$(whoami)" "$FILE"
		fi
		rm "$ROOTOVERLAY"
		;;
	*.tar.gz)
		trap clean EXIT
		ROOT="$(mktemp -d)"
		write_customization_alpine "$@"
		ROOTOVERLAY="$(sudo mktemp)"
		sudo tar -czf "$ROOTOVERLAY" -C "$ROOT" .
		sudo rm -r "$ROOT"
		ROOT="$(mktemp -d)"
		DISKLABEL="$(fnmatch "rpi[1-4]" "$HARDWARE" && echo dos || echo gpt)"
		FILE="${FILE:-${SOURCE%.tar.gz}.img}"
		create_root "$FILE" "$ROOT" "$DISKLABEL" "${SIZE-16G}"
		sudo tar --numeric-owner -xzf "$SOURCE" -C "$ROOT/boot"
		sudo mv "$ROOTOVERLAY" "$ROOT/boot/localhost.apkovl.tar.gz"
		;;
	esac
}

write_arch_customization() {
	INIT=systemd write_customization_shared "$@"
}

write_distro_arch() {
	ROOT="$(mktemp -d)"
	trap clean EXIT
	create_root "$FILE" "$ROOT" \
		"$(fnmatch "usb" "$HARDWARE" || fnmatch "xps13" "$HARDWARE" && echo gpt || echo dos)" \
		"${SIZE-16G}"

	if [ "${HARDWARE%[1-5]}" = rpi ]; then
		echo "Actually downloading/writing data. This may take a while..." >&2
		sudo tar -xpf "$(get_rpi_image "$HARDWARE")" -C "$ROOT"
		[ "$HARDWARE" != rpi4 ] \
			|| sudo sed -i 's/mmcblk0/mmcblk1/g' "$ROOT/etc/fstab"
		if [ "$HARDWARE" = rpi5 ]; then
			download http://mirror.archlinuxarm.org/aarch64/core/$(
			)linux-rpi-6.6.28-1-aarch64.pkg.tar.xz \
				"${XDG_CACHE_HOME:-$HOME/.cache}/rpi_img/linux-rpi.pkg.tar.xz"
			sudo rm -rf "$ROOT/boot"/*
			sudo tar -xpf \
				"${XDG_CACHE_HOME:-$HOME/.cache}/$(
				)rpi_img/linux-rpi.pkg.tar.xz" \
				-C "$ROOT"
			<"$ROOT/boot/cmdline.txt" sed \
				"s|root=[^ ]*|root=$(get_dev_for "$ROOT")|" \
				| sudo tee "$ROOT/boot/cmdline.txt.new" >/dev/null \
				&& sudo mv "$ROOT/boot/cmdline.txt.new" \
					"$ROOT/boot/cmdline.txt"
			<"$ROOT/etc/fstab" sed \
				-e "s|/dev/mmcblk0p2|$(get_dev_for "$ROOT")|" \
				-e "s|/dev/mmcblk0p1|$(get_dev_for "$ROOT/boot")|" \
				| sudo tee "$ROOT/etc/fstab.new" >/dev/null \
				&& sudo mv "$ROOT/etc/fstab.new" "$ROOT/etc/fstab"
		fi
	else
		if [ "$HARDWARE" = live ]; then
			sudo pacman --needed --noconfirm -S archiso
			</usr/share/archiso/configs/releng/packages.x86_64 grep \
				-vE '^(#|grml-zsh-config)' \
				| to_argv sudo pacstrap "$ROOT"
		else
			sudo pacstrap "$ROOT" base linux linux-firmware \
				arch-install-scripts
		fi
	fi
	genfstab -U "$ROOT" | sudo tee "$ROOT/etc/fstab" >/dev/null
	write_arch_customization "$@"
	if [ "$ARCH" = "$(uname -m)" ]; then
		sudo arch-chroot "$ROOT" sh -euc '
			cd /root/.local/src/roles;
			export HOSTNAME='"$HOSTNAME"';
			export HARDWARE='"${HARDWARE-server}"';
			./install_arch
			systemctl enable local-provisioning.service
		'
		if [ -f "$ROOT/boot/syslinux.cfg" ]; then
			BOOTDEV="$(get_dev_for "$ROOT/boot")"
			sudo umount "$ROOT/boot"
			sudo syslinux "$BOOTDEV"
			sudo dd if=/usr/lib/syslinux/bios/mbr.bin \
				of="${BACKING_FILE:-$FILE}" bs=512 conv=notrunc
		fi
	fi
}

write_os() {
	while getopts h:m:n:d:f:s:r OPT "$@"; do
		case "$OPT" in
		h) HARDWARE="$OPTARG" ;;
		m) ARCH="$OPTARG" ;;     #Same as uname
		n) HOSTNAME="$OPTARG" ;; #Same as uname
		d) DISTRO="$OPTARG" ;;
		f) FILE="$OPTARG" ;;
		s) SIZE="$OPTARG" ;;
		r) RUN=true ;;
		*) printf "ERROR: Unknown option: %s" "$OPT" >&2 && return 1 ;;
		esac
	done
	shift $((OPTIND - 1)) && OPTIND=1
	[ -n "${FILE:-}" ] || die "Specify a device/file with -f FILE"
	if [ -z "${HARDWARE-}" ]; then
		if [ -e /sys/firmware/devicetree/base/model ]; then
			HARDWARE="$(
				</sys/firmware/devicetree/base/model tr -d '\0' \
					| sed -E 's/Raspberry Pi ([0-9]).*/rpi\1/'
			)"
		elif fnmatch '/dev/nvme*' "$FILE"; then
			HARDWARE=standard
		else
			HARDWARE=live
		fi
	fi
	if [ -z "${ARCH-}" ]; then
		case "$HARDWARE" in
		rpi1) ARCH=armhf ;;
		rpi2) ARCH=armv7 ;;
		rpi[345]) ARCH=aarch64 ;;
		live) ARCH=x86_64 ;;
		standard) ARCH="$(uname_to_arch)" ;;
		esac
	fi
	DISTRO="${DISTRO-alpine}"
	case "$DISTRO" in
	alpine) write_distro_alpine "$@" ;;
	arch) write_distro_arch "$@" ;;
	esac
	if
		[ "${RUN-}" = true ] && [ "$ARCH" = x86_64 ] \
			&& [ "$(uname_to_arch)" = x86_64 ]
	then
		if ! exists qemu-system-x86_64; then
			if exists apk; then
				sudo apk add -q qemu-system-x86_64
			elif exists pacman; then
				sudo pacman --needed --noconfirm -qS qemu-system-x86
			fi
		fi
		STTY_SETTINGS="$(stty -g)"
		qemu-system-x86_64 -m 5120 -nic user \
			-drive if=ide,media=disk,format=raw,file="${BACKING_FILE-$FILE}" \
			-enable-kvm -display none \
			-chardev stdio,id=serial0,signal=off \
			-serial chardev:serial0 -monitor none
		stty "$STTY_SETTINGS"
		tput smam
	fi
}

write_os "$@"
