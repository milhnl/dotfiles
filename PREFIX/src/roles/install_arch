#!/usr/bin/env sh
#install_arch - install arch, run as root
set -eux

in_chroot() { ! [ / -ef /proc/1/root ]; }
sponge() { set -- "$1" "$(mktemp)" && cat >"$2" && mv "$2" "$1"; }
set_file() (f="$1" && shift && printf '%s\n' "$@" | tee "$f" >/dev/null)

systemctl_enable() {
	if in_chroot; then
		while [ $# -gt 0 ]; do
			ln -s \
				"/lib/systemd/system/$(
					printf %s "$1" | sed 's/@.*/@/'
				).service" \
				"/etc/systemd/system/multi-user.target.wants/${1}.service"
			shift
		done
	else
		systemctl enable "$@"
	fi
}

passwd -d root
printf 'en_US.UTF-8 UTF-8\nC UTF-8\n' >/etc/locale.gen
locale-gen
echo 'LANG=en_US.UTF-8' >/etc/locale.conf
ln -sf /usr/share/zoneinfo/Europe/Amsterdam /etc/localtime
hwclock --systohc || :
ROOT_DEV="$(df -P / | awk 'END { print $1 }')"
ROOT_UUID="$(blkid --output export "$ROOT_DEV" | sed -n 's/^UUID=//p')"
grep -q '^[^#]' /etc/fstab || genfstab -Up / >/etc/fstab
pacman-key --init
pacman-key --populate \
	"archlinux$(uname -m | sed -n 's/\(armv[67]l\|aarch64\)/arm/p')"
pacman --needed --noconfirm -qS dhcpcd netctl dialog wpa_supplicant
if [ "$HARDWARE" = live ]; then
	</etc/mkinitcpio.conf sed '/^HOOKS/{
			s/block //;s/keyboard //;s/autodetect /block keyboard &/}' \
		| sponge /etc/mkinitcpio.conf
	mkinitcpio -p linux
	pacman --needed --noconfirm -qS syslinux
	mkdir -p /boot/EFI/syslinux
	cp -r /usr/lib/syslinux/efi64/* /boot/EFI/syslinux/
	[ -d /boot/EFI/boot ] || mv /boot/EFI/syslinux /boot/EFI/boot
	cp /boot/EFI/boot/syslinux.efi /boot/EFI/boot/bootx64.efi
	mkdir -p /boot/syslinux
	</usr/share/syslinux/syslinux.cfg sed \
		-e "s_root=/dev/[^ ]*_root=UUID=${ROOT_UUID}_" \
		-e "s_INITRD _INITRD ../amd-ucode.img,../intel-ucode.img,_" \
		>/boot/syslinux/syslinux.cfg
elif [ "${HARDWARE%[1-5]}" = rpi ]; then
	if ([ -z "${HARDWARE-}" ] \
		&& </proc/cpuinfo grep -Eq "Raspberry Pi (5|Zer)" \
		|| [ "${HARDWARE-}" = rpi5 ] || [ "${HARDWARE-}" = rpi3 ]) \
		&& pacman -Qi linux-aarch64 >/dev/null 2>&1; then
		pacman --noconfirm -R linux-aarch64 uboot-raspberrypi
		pacman --noconfirm --needed -qSyu \
			--overwrite "/boot/*" \
			--overwrite "/usr/lib/modules/*" \
			--overwrite "/etc/mkinitcpio.d/*" \
			linux-rpi
	fi
elif [ "${HARDWARE%[1-5]}" != rpi ]; then
	pacman --needed --noconfirm -qS syslinux intel-ucode amd-ucode
	set_file /boot/syslinux.cfg \
		'DEFAULT arch' 'TIMEOUT 5' 'PROMPT 1' 'LABEL arch' \
		'LINUX ./vmlinuz-linux' \
		"INITRD ./intel-ucode.img,./amd-ucode.img,./initramfs-linux.img" \
		"APPEND root=UUID=${ROOT_UUID} rw console=tty1 console=ttyS0"
	sed -i -E \
		-e '/^MODULES=/s/=.*/=(ata_piix pata_acpi ahci virtio_blk nvme)/' \
		-e '/^HOOKS=/s/=.*/=(systemd autodetect modconf block filesystems keyboard fsck)/' \
		/etc/mkinitcpio.conf
	mkinitcpio -p linux
	mkdir -p /boot/EFI/BOOT
	cp -n /usr/lib/syslinux/efi64/* /boot/EFI/BOOT/
	cp -n /boot/EFI/BOOT/syslinux.efi /boot/EFI/BOOT/BOOTX64.EFI
	</boot/syslinux.cfg sed 's|\./|../../|g' >/boot/EFI/BOOT/syslinux.cfg
	systemctl_enable getty@tty1 getty@ttyS0
fi
